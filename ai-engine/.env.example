# ==========================================
# AI ENGINE (chatbot.py & forecaster.py)
# Salin menjadi .env lalu isi sesuai server (lokal / VPS)
# ==========================================

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Target backend Laravel (host/IP). URL final: http://{API_TARGET_URL}:{LARAVEL_API_PORT}/api/ai-data
API_TARGET_URL=127.0.0.1
LARAVEL_API_PORT=8001
# Opsional: override URL penuh (jika diisi, API_TARGET_URL & LARAVEL_API_PORT diabaikan)
# LARAVEL_API_URL=http://127.0.0.1:8001/api/ai-data
AI_API_KEY=

# Bind server Flask
AI_ENGINE_HOST=127.0.0.1
AI_ENGINE_PORT=5000
# Set false di VPS/production
FLASK_DEBUG=true

# Database (forecaster.py & test_forecaster.py)
DB_USER=root
DB_PASS=
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=inventory_db

