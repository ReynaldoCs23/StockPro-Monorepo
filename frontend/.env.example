# ==========================================
# FRONTEND STOCKPRO ERP (Vite + React)
# Salin menjadi .env lalu sesuaikan dengan host/IP backend dan websocket
# ==========================================

# Base URL API Laravel Backend (gunakan IP/Domain VPS atau localhost)
VITE_API_BASE_URL="http://127.0.0.1:8000/api"
VITE_API_URL="http://127.0.0.1:8000"

# Laravel Reverb / WebSockets Realtime
VITE_REVERB_APP_KEY=""
VITE_REVERB_HOST="127.0.0.1"
VITE_REVERB_PORT="8090"
VITE_REVERB_SCHEME="http"

